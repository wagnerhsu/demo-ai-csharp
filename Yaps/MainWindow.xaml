<Window x:Class="Yaps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YAPS - Yet Another Port Scanner"
        Width="645" Height="520"
        MinWidth="645" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="23" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OptionBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Start Port" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="StartPortBox" Text="3500" Style="{StaticResource FieldBox}" />
                <TextBlock Grid.Row="1" Text="Stop Port" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="StopPortBox" Text="3600" Style="{StaticResource FieldBox}" />
                <TextBlock Grid.Row="2" Text="Timeout (ms)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TimeoutBox" Text="2500" Style="{StaticResource FieldBox}" />
                <TextBlock Grid.Row="3" Text="Simultaneous" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="SimultaneousBox" Text="100" Style="{StaticResource FieldBox}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="177" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Start Address" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="StartAddressBox" Text="192.168.100.1" Style="{StaticResource FieldBox}" />
                    <TextBlock Grid.Row="1" Text="Stop Address" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="StopAddressBox" Text="192.168.100.1" Style="{StaticResource FieldBox}" />
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,18,0,0">
                        <RadioButton x:Name="PortsFirstRadio" Content="scan ports first" IsChecked="True" Margin="0,0,0,6" />
                        <RadioButton x:Name="IpsFirstRadio" Content="scan IPs first" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ResolveNamesCheck" Content="Resolve names" Style="{StaticResource OptionBox}" Click="OnLiveOptionChanged" />
                        <CheckBox x:Name="ContinuousCheck" Content="Continuous" Style="{StaticResource OptionBox}" />
                        <CheckBox x:Name="HideErrorsCheck" Content="Hide Errors" Style="{StaticResource OptionBox}" Click="OnLiveOptionChanged" />
                        <CheckBox x:Name="ProbePortsCheck" Content="Probe Ports" Style="{StaticResource OptionBox}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="3" Width="90" VerticalAlignment="Top">
                <Button x:Name="StartButton" Content="Start" IsDefault="True" Style="{StaticResource ActionButton}" Click="OnStartClick" />
                <Button x:Name="StopButton" Content="Stop" IsEnabled="False" Style="{StaticResource ActionButton}" Click="OnStopClick" />
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource ActionButton}" Click="OnCloseClick" />
                <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource ActionButton}" Click="OnClearClick" />
                <Button x:Name="AboutButton" Content="About" Style="{StaticResource ActionButton}" Click="OnAboutClick" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,6,0,0" />

        <ProgressBar Grid.Row="2" x:Name="ScanProgress" Height="27" Margin="0,8,0,0"
                     Minimum="0" Maximum="1" Value="0" Foreground="#107C10" />

        <TextBox Grid.Row="3" x:Name="OutputBox" Margin="0,8,0,0"
                 IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
